{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/vendor/jquery-datatable/dataTables.bootstrap4.min.css') }}" />
    <link rel="stylesheet" href="{{ asset('assets/vendor/jquery-datatable/fixedeader/dataTables.fixedcolumns.bootstrap4.min.css') }}" />
    <link rel="stylesheet" href="{{ asset('assets/vendor/jquery-datatable/fixedeader/dataTables.fixedheader.bootstrap4.min.css') }}" />
    <link rel="stylesheet" href="{{ asset('assets/vendor/sweetalert/sweetalert.css') }}" />

    <style>
        .bd-example-modal-lg .modal-dialog {
            display: table;
            position: relative;
            margin: 0 auto;
            top: calc(50% - 24px);
        }

        .bd-example-modal-lg .modal-dialog .modal-content {
            background-color: transparent;
            border: none;
        }
    </style>
{% endblock %}

{% block titre %}Liste des jeunes cotisés{% endblock %}

{% block body %}

    <div class="modal modal_load fade bd-example-modal-lg" data-backdrop="static" data-keyboard="false" tabindex="-1">
        <div class="modal-dialog modal-sm">
            <div class="modal-content" style="width:48px">
                <span class="fa fa-spinner fa-spin fa-3x"></span>
            </div>
        </div>
    </div>

    <div class="block-header">
        <div class="row clearfix">
            <div class="col-md-6 col-sm-12"></div>
        </div>
    </div>

    <div class="col-lg-12">
        <div class="card">
            <div class="header">
                <h2 class="text-center">Liste des jeunes Cotisés</h2>
            </div>
            <div class="body">
                <div class="table-responsive">
                    <table class="table" id="tbjeune">
                        <thead>
                        <tr>
                            <th>ID</th>
                            <th>MATRICULE</th>
                            <th>NOM</th>
                            <th>PRENOMS</th>
                            <th>TELEPHONE</th>
                        </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

{% endblock %}

{% block javascripts %}
    <script src="{{ asset('assets/vendor/jquery-datatable/jquery.dataTables.min.js') }}"></script>
    <script src="{{ asset('assets/vendor/sweetalert/sweetalert.min.js') }}"></script>

    <script src="{{ asset('assets/bundles/datatablescripts.bundle.js') }}"></script>
    <script src="{{ asset('assets/vendor/jquery-datatable/buttons/dataTables.buttons.min.js') }}"></script>
    <script src="{{ asset('assets/vendor/jquery-datatable/buttons/buttons.bootstrap4.min.js') }}"></script>
    <script src="{{ asset('assets/vendor/jquery-datatable/buttons/buttons.colVis.min.js') }}"></script>
    <script src="{{ asset('assets/vendor/jquery-datatable/buttons/buttons.html5.min.js') }}"></script>
    <script src="{{ asset('assets/vendor/jquery-datatable/buttons/buttons.print.min.js') }}"></script>

    <script>
        $(function () {
            var jeuneId = '';

            var table = $('#tbjeune').DataTable({
                language: {
                    processing: 'Traitement en cours...',
                    search: 'Rechercher&nbsp;:',
                    lengthMenu: 'Afficher _MENU_ &eacute;l&eacute;ments',
                    info: "Affichage de l'&eacute;lement _START_ &agrave; _END_ sur _TOTAL_ &eacute;l&eacute;ments",
                    infoEmpty: "Affichage de l'&eacute;lement 0 &agrave; 0 sur 0 &eacute;l&eacute;ments",
                    infoFiltered: '(filtr&eacute; de _MAX_ &eacute;l&eacute;ments au total)',
                    loadingRecords: 'Chargement en cours...',
                    zeroRecords: 'Aucune Cotisation enregistree',
                    emptyTable: 'Aucune donnée disponible dans le tableau',
                    paginate: {
                        first: 'Premier', previous: 'Pr&eacute;c&eacute;dent', next: 'Suivant', last: 'Dernier'
                    }
                },
                columns: [
                    {data: 'ID'}, {data: 'MATRICULE'}, {data: 'NOM'}, {data: 'PRENOMS'}, {data: 'TELEPHONE'}
                ],
                columnDefs: [{targets: 0, visible: false}],
                data: [],
                filter: true,
                info: true,
                ordering: false,
                processing: false,
                retrieve: true
            });

            loadData();

            function loadData() {
                $.ajax({
                    type: 'GET',
                    url: '{{ path("GetListeJeuneCotiseParGroupe") }}',
                    success: function (resp) {
                        if (resp.ok === true) {
                            table.clear();
                            var liste = JSON.parse(resp.data || '[]');
                            var rows = [];
                            $.each(liste, function (i, n) {
                                rows.push({
                                    ID: n.id,
                                    MATRICULE: n.matricule,
                                    NOM: n.nom,
                                    PRENOMS: n.prenoms,
                                    TELEPHONE: n.telephone
                                });
                            });
                            table.rows.add(rows).draw();
                        } else {
                            swal({type: 'error', title: 'Cotisation', text: resp.message});
                        }
                    },
                    error: function () {
                        swal({type: 'error', title: 'Cotisation', text: 'Erreur lors du chargement des données.'});
                    }
                });
            }

            // Handle row button click if any button is added later
            $('#tbjeune tbody').on('click', 'button[id=cotisation]', function () {
                var row = table.row($(this).closest('tr')).data();
                jeuneId = row ? row.ID : '';
                $('#modalmodif').modal('show');
            });

            $('#saveCotisation').on('click', function () {
                var matricule = $('#matricule').val();
                if (!matricule) {
                    swal({type: 'warning', text: 'Veuillez remplir le champ matricule svp !'});
                    return;
                }

                $.ajax({
                    type: 'POST',
                    url: '{{ path('SaveCotisation') }}',
                    data: {value: matricule, JeuneId: jeuneId},
                    success: function (res) {
                        if (res.Ok === true || res.ok === true) {
                            swal({type: 'success', text: 'Opération effectuée avec succès'});
                            loadData();
                            $('#modalmodif').modal('hide');
                        } else {
                            swal({type: 'error', text: res.message});
                        }
                    },
                    error: function () {
                        swal({type: 'error', text: 'Erreur serveur lors de la sauvegarde.'});
                    }
                });
            });
        });
    </script>
{% endblock %}